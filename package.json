{
  "name": "turnnote",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform AI meeting assistant.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:js && npm run lint:py",
    "lint:js": "eslint . && prettier --check .",
    "lint:py": "ruff check services && ruff format --check services",
    "format": "eslint . --fix && prettier --write . && ruff check --fix services && ruff format services",
    "test": "node scripts/test.mjs",
    "test:electron": "node scripts/check-electron-storage.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "package:mac:arm64": "node scripts/check-package-target.mjs darwin arm64 && npm run build:sidecar && npm run build && electron-builder --mac dmg --arm64",
    "package:win:x64": "node scripts/check-package-target.mjs win32 x64 && npm run build:sidecar && npm run build && electron-builder --win nsis --x64",
    "labels:sync": "node scripts/sync-labels.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-audio-loopback": "1.0.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "^4.0.0",
    "esbuild": "0.25.12",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "^7.1.3"
  }
}
