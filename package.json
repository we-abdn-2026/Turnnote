{
  "name": "turnnote",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform AI meeting assistant.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:js && npm run lint:py",
    "lint:js": "eslint . && prettier --check .",
    "lint:py": "ruff check services && ruff format --check services",
    "format": "eslint . --fix && prettier --write . && ruff check --fix services && ruff format services",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.4.5",
    "electron-vite": "^4.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "^7.1.3"
  }
}
