{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["packages/contracts/src/*"]
    }
  },
  "include": [
    "apps",
    "packages",
    "tests/support/runtime.ts",
    "electron.vite.config.ts",
    "vite.renderer.config.ts"
  ]
}
